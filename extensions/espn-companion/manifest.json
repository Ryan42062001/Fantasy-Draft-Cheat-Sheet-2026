{
  "manifest_version": 3,
  "name": "The War Room — ESPN Draft Companion",
  "version": "0.9.7",
  "description": "Syncs ESPN fantasy football draft picks directly into The War Room.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://www.espn.com/fantasy/*",
    "https://api.fantasypros.com/public/v2/json/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://ryan42062001.github.io/Fantasy-Draft-Cheat-Sheet-2026/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "The War Room ESPN Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*"
      ],
      "js": [
        "espn-live-capture.js",
        "espn-live-observer.js",
        "espn-page-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*"
      ],
      "js": [
        "espn-live-capture.js",
        "espn-api.js",
        "espn-parser.js",
        "espn-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://ryan42062001.github.io/Fantasy-Draft-Cheat-Sheet-2026/*"
      ],
      "js": [
        "war-room-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
